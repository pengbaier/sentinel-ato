# Copy to .env and fill in. Never commit .env.

# Nicrron gateway (nicrron.ai/dashboard -> Create an API key)
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
# Check exact ids with:  python -c "from sentinel.integrations import llm_list_models as m; print([x for x in m() if 'claude' in x])"
NICRRON_MODEL=anthropic/claude-sonnet-5-5
NICRRON_DEEP_MODEL=anthropic/claude-opus-5-5

# PRISM by Block Convey (prism.blockconvey.com -> Settings -> Project for the id; Developers -> API keys, scope: ingest)
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
